# [EN]    Base URL of the SolidSign API (without trailing slash)
# [PT-BR] URL base da API SolidSign (sem barra no final)
SOLIDSIGN_API_BASE_URL=https://solidsign.com.br

# [EN]    Authorization header value — include "Bearer " prefix
# [PT-BR] Valor do header Authorization — inclua o prefixo "Bearer "
SOLIDSIGN_API_AUTHORIZATION=Bearer YOUR_JWT_TOKEN_HERE

# [EN]    Signature parameters shared across all 5 documents
# [PT-BR] Parâmetros de assinatura compartilhados pelos 5 documentos
SOLIDSIGN_DIPLOMA_HASH_ALGORITHM=SHA256
SOLIDSIGN_DIPLOMA_SIGNATURE_PACKAGING=ENVELOPED
SOLIDSIGN_DIPLOMA_CANONICALIZATION_METHOD=EXCLUSIVE

# ═══════════════════════════════════════════════════════════════════════════
# [EN]    DOCUMENT 1/5 — Documentação Acadêmica de Registro (3 steps)
# [PT-BR] DOCUMENTO 1/5 — Documentação Acadêmica de Registro (3 etapas)
# ═══════════════════════════════════════════════════════════════════════════
# Step 1 — IES Representantes (e-CPF). Repeat once per signer (1..n).
SOLIDSIGN_DOCACAD_STEP1_NODE_NAME=DadosDiploma
SOLIDSIGN_DOCACAD_STEP1_NAMESPACE=http://portal.mec.gov.br/diplomadigital/arquivos-em-xsd
SOLIDSIGN_DOCACAD_STEP1_PROFILE=ADRT
SOLIDSIGN_DOCACAD_STEP1_REMOVE_XPATH_FILTER=false
# Step 2 — IES Emissora (e-CNPJ), last "dados" signature, XPath filter removed.
SOLIDSIGN_DOCACAD_STEP2_NODE_NAME=DadosDiploma
SOLIDSIGN_DOCACAD_STEP2_NAMESPACE=http://portal.mec.gov.br/diplomadigital/arquivos-em-xsd
SOLIDSIGN_DOCACAD_STEP2_PROFILE=ADRT
SOLIDSIGN_DOCACAD_STEP2_REMOVE_XPATH_FILTER=true
# Step 3 — IES Emissora (e-CNPJ) seals the final envelope (AD-RA).
SOLIDSIGN_DOCACAD_STEP3_NODE_NAME=DocumentacaoAcademicaRegistro
SOLIDSIGN_DOCACAD_STEP3_NAMESPACE=http://portal.mec.gov.br/diplomadigital/arquivos-em-xsd
SOLIDSIGN_DOCACAD_STEP3_PROFILE=ADRA
SOLIDSIGN_DOCACAD_STEP3_REMOVE_XPATH_FILTER=true

# ═══════════════════════════════════════════════════════════════════════════
# [EN]    DOCUMENT 2/5 — Diploma Digital. ASSEMBLED first (POST .../diploma/assemble copies
#         <DadosDiploma> from the signed Documentação Acadêmica into the Diploma envelope
#         template, see templates/diploma-template.xml), then signed in 2 steps.
# [PT-BR] DOCUMENTO 2/5 — Diploma Digital. MONTADO primeiro, depois assinado em 2 etapas.
# ═══════════════════════════════════════════════════════════════════════════
# Step 1 — Representante da Registradora (e-CPF) signs DadosRegistro.
SOLIDSIGN_DIPLOMA_STEP1_NODE_NAME=DadosRegistro
SOLIDSIGN_DIPLOMA_STEP1_NAMESPACE=http://portal.mec.gov.br/diplomadigital/arquivos-em-xsd
SOLIDSIGN_DIPLOMA_STEP1_PROFILE=ADRT
SOLIDSIGN_DIPLOMA_STEP1_REMOVE_XPATH_FILTER=false
# Step 2 — IES Registradora (e-CNPJ) seals the final envelope (AD-RA).
SOLIDSIGN_DIPLOMA_STEP2_NODE_NAME=Diploma
SOLIDSIGN_DIPLOMA_STEP2_NAMESPACE=http://portal.mec.gov.br/diplomadigital/arquivos-em-xsd
SOLIDSIGN_DIPLOMA_STEP2_PROFILE=ADRA
SOLIDSIGN_DIPLOMA_STEP2_REMOVE_XPATH_FILTER=true

# ═══════════════════════════════════════════════════════════════════════════
# [EN]    DOCUMENT 3/5 — Histórico Escolar Digital. PARTIAL: call step2 only.
#         FULL: call step1 then step2.
# [PT-BR] DOCUMENTO 3/5 — Histórico Escolar Digital. PARCIAL: chame só a step2.
#         INTEGRAL: chame a step1 e depois a step2.
# ═══════════════════════════════════════════════════════════════════════════
# Step 1 — Representante da Secretaria (e-CPF), FULL modality only.
SOLIDSIGN_HISTESC_STEP1_NODE_NAME=DadosHistoricoEscolar
SOLIDSIGN_HISTESC_STEP1_NAMESPACE=http://portal.mec.gov.br/diplomadigital/arquivos-em-xsd
SOLIDSIGN_HISTESC_STEP1_PROFILE=ADRT
SOLIDSIGN_HISTESC_STEP1_REMOVE_XPATH_FILTER=false
# Step 2 — IES Emissora (e-CNPJ) seals the final envelope (AD-RA). Always required.
SOLIDSIGN_HISTESC_STEP2_NODE_NAME=HistoricoEscolar
SOLIDSIGN_HISTESC_STEP2_NAMESPACE=http://portal.mec.gov.br/diplomadigital/arquivos-em-xsd
SOLIDSIGN_HISTESC_STEP2_PROFILE=ADRA
SOLIDSIGN_HISTESC_STEP2_REMOVE_XPATH_FILTER=true

# ═══════════════════════════════════════════════════════════════════════════
# [EN]    DOCUMENT 4/5 — Currículo Escolar Digital. Signed over the ENTIRE document (no
#         signatureNodeName), 2 steps: Coordenador do Curso then IES Emissora.
# [PT-BR] DOCUMENTO 4/5 — Currículo Escolar Digital. Assinado sobre o DOCUMENTO INTEIRO.
# ═══════════════════════════════════════════════════════════════════════════
SOLIDSIGN_CURRESC_STEP1_PROFILE=ADRT
SOLIDSIGN_CURRESC_STEP1_REMOVE_XPATH_FILTER=false
SOLIDSIGN_CURRESC_STEP2_PROFILE=ADRA
SOLIDSIGN_CURRESC_STEP2_REMOVE_XPATH_FILTER=true

# ═══════════════════════════════════════════════════════════════════════════
# [EN]    DOCUMENT 5/5 — Lista de Diplomas Anulados / Arquivo de Fiscalização. Single step,
#         signed over the ENTIRE document (no signatureNodeName), e-CNPJ.
# [PT-BR] DOCUMENTO 5/5 — Lista de Diplomas Anulados / Arquivo de Fiscalização. Etapa única.
# ═══════════════════════════════════════════════════════════════════════════
SOLIDSIGN_LISTAANUL_PROFILE=ADRT
SOLIDSIGN_LISTAANUL_REMOVE_XPATH_FILTER=false

PORT=8095
